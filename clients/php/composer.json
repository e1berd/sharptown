{
    "name": "sharptown/client",
    "description": "Expressive PHP client for the Sharptown image transformation API. Supports the REST, JSON-RPC and gRPC transports.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sharptown", "image", "resize", "convert", "webp", "sharp", "client", "grpc", "jsonrpc"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "psr/http-message": "Pass a PSR-7 StreamInterface (e.g. an S3/Guzzle response body) straight to transform()."
    },
    "autoload": {
        "psr-4": {
            "Sharptown\\Client\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sharptown\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
