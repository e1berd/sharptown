---
import { getCollection, render } from 'astro:content'
import DocsLayout from '../../layouts/DocsLayout.astro'

/**
 * Statically renders the English docs. Entry ids are `en/<slug>`; the route param drops
 * the locale prefix so the URL is `/docs/<slug>`. Fully SSG via `getStaticPaths`.
 */
export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries
    .filter((entry) => entry.id.startsWith('en/'))
    .map((entry) => ({
      params: { slug: entry.id.slice('en/'.length) },
      props: { entry },
    }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const slug = entry.id.slice('en/'.length)
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  locale="en"
  slug={slug}
  headings={headings}
>
  <Content />
</DocsLayout>
