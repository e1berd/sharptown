{
  "name": "sharptown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @sharptown/server-rest dev:env",
    "rest": "pnpm --filter @sharptown/server-rest dev:env",
    "grpc": "pnpm --filter @sharptown/server-grpc dev:env",
    "jsonrpc": "pnpm --filter @sharptown/server-jsonrpc dev:env",
    "docs": "pnpm --filter @sharptown/docs dev",
    "docs:build": "pnpm --filter @sharptown/docs build",
    "build": "pnpm -r build"
  }
}
