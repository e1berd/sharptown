{
  "name": "@sharptown/core",
  "version": "1.0.0",
  "description": "Framework-agnostic image transformation engine for Sharptown, powered by Sharp. Reused by every server adapter (Fastify, Hono, Elysia, Express, gRPC).",
  "type": "module",
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
