{
  "name": "@sharptown/client",
  "version": "1.0.0",
  "description": "Expressive, isomorphic JavaScript client for the Sharptown image transformation API. Works in the browser, Node, Bun and Deno.",
  "type": "module",
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test"
  },
  "keywords": [
    "sharptown",
    "image",
    "sharp",
    "resize",
    "convert",
    "webp",
    "isomorphic",
    "client"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
