{
  "name": "@sharptown/fastify-plugin",
  "version": "1.1.0",
  "description": "Fastify plugin for Sharptown — a single /transform route on top of @sharptown/core.",
  "type": "module",
  "main": "./src/index.mjs",
  "module": "./src/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^9.3.0",
    "@sharptown/core": "workspace:*",
    "fastify-plugin": "^5.0.1"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "fastify": "^5.0.0",
    "typescript": "^5.5.0"
  }
}
