{
  "name": "@sharptown/astro",
  "version": "1.0.0",
  "description": "Astro bindings for Sharptown: a single-<img> <ImageDelivery> component that builds signed image-transform URLs.",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./ImageDelivery.astro": "./src/ImageDelivery.astro"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sharptown",
    "astro",
    "image",
    "img",
    "component",
    "transform",
    "resize"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e1berd/sharptown.git",
    "directory": "packages/astro"
  },
  "peerDependencies": {
    "@sharptown/client": ">=1.2.0",
    "astro": ">=4"
  },
  "devDependencies": {
    "@sharptown/client": "workspace:*"
  }
}
